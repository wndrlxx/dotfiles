[user]
  email = 64194574+wndrlxx@users.noreply.github.com
  name = wndrlxx
[core]
	excludesfile = ~/.gitignore_global
  editor = nvim
  pager = delta
[interactive]
  diffFilter = delta --color-only
[delta]
	navigate = true
	side-by-side = true
	line-numbers = true
  syntax-theme = 'Catppuccin-mocha'
[merge]
  conflictstyle = diff3
[diff]
  colorMoved = default
