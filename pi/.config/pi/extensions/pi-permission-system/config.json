{
  "$schema": "https://raw.githubusercontent.com/gotgenes/pi-packages/main/packages/pi-permission-system/schemas/permissions.schema.json",
  "authorizerChain": ["pi-auto-review"],
  "yoloMode": false,
  "permission": {
    "*": "ask",
    "read": "allow",
    "todo": "allow",
    "ask_user_question": "allow",
    "plan_mode_question": "allow",
    "plan_mode_complete": "allow",
    "web_enable": "allow",
    "web_search": "allow",
    "fetch_content": "allow",
    "source_check": "allow",
    "get_search_content": "allow",
    "grep": "allow",
    "find": "allow",
    "ls": "allow",
    "ffgrep": "allow",
    "fffind": "allow",
    "path_read": {
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow",
      "~/.ssh": "deny",
      "~/.ssh/*": "deny",
      "~/.gnupg": "deny",
      "~/.gnupg/*": "deny",
      "~/.aws": "deny",
      "~/.aws/*": "deny",
      "~/.kube": "deny",
      "~/.kube/*": "deny",
      "~/.config/gcloud": "deny",
      "~/.config/gcloud/*": "deny",
      "~/.config/gh/hosts.yml": "deny",
      "~/.docker/config.json": "deny",
      "~/.config/pi/auth.json": "deny",
      "~/.config/pi/web-search.json": "deny",
      "~/.netrc": "deny"
    },
    "path_write": {
      "*": "ask",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "ask",
      "~/.ssh": "deny",
      "~/.ssh/*": "deny",
      "~/.gnupg": "deny",
      "~/.gnupg/*": "deny",
      "~/.aws": "deny",
      "~/.aws/*": "deny",
      "~/.kube": "deny",
      "~/.kube/*": "deny",
      "~/.config/gcloud": "deny",
      "~/.config/gcloud/*": "deny",
      "~/.config/gh/hosts.yml": "deny",
      "~/.docker/config.json": "deny",
      "~/.config/pi/auth.json": "deny",
      "~/.config/pi/web-search.json": "deny",
      "~/.netrc": "deny"
    },
    "external_directory_read": "ask",
    "external_directory_write": "ask",
    "bash": "ask"
  }
}
