# Run `ghostty +show-config --default --docs` to view a list of
# all available config options and their default values.

# theme = dark:Catppuccin Frappe,light:Catppuccin Latte
theme = dark:TokyoNight,light:Rose Pine Dawn
macos-titlebar-style = tabs
macos-window-buttons = hidden
macos-non-native-fullscreen = true
font-size = 17

# Create splits
keybind = ctrl+shift+backslash=new_split:right
keybind = ctrl+shift+minus=new_split:down

# Navigate splits
keybind = super+ctrl+h=goto_split:left
keybind = super+ctrl+j=goto_split:bottom
keybind = super+ctrl+k=goto_split:top
keybind = super+ctrl+l=goto_split:right
keybind = super+ctrl+z=toggle_split_zoom

# Resize splits
keybind = ctrl+shift+h=resize_split:left,40
keybind = ctrl+shift+j=resize_split:down,40
keybind = ctrl+shift+k=resize_split:up,40
keybind = ctrl+shift+l=resize_split:right,40

# Transparency
background-opacity-cells=true
background-blur=macos-glass-regular
background-opacity = 0.88

# macos-icon: blueprint, chalkboard, glass, holographic, retro, xray
macos-icon = holographic
