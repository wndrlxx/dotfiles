# https://ghostty.org/docs/config/reference

font-size = 20
theme = dark:TokyoNight, light:Rose Pine Dawn

# Transparency
background-opacity = 0.8
background-opacity-cells=true
background-blur=macos-glass-regular

macos-icon = holographic
macos-titlebar-style = tabs
macos-window-buttons = hidden
window-padding-balance = true

# Create splits
keybind = super+shift+backslash=new_split:right
keybind = super+shift+minus=new_split:down

# Navigate splits
keybind = super+opt+h=goto_split:left
keybind = super+opt+j=goto_split:bottom
keybind = super+opt+k=goto_split:top
keybind = super+opt+l=goto_split:right
keybind = super+opt+z=toggle_split_zoom

# Resize splits
keybind = super+shift+h=resize_split:left,40
keybind = super+shift+j=resize_split:down,40
keybind = super+shift+k=resize_split:up,40
keybind = super+shift+l=resize_split:right,40
keybind = super+shift+equal=equalize_splits

