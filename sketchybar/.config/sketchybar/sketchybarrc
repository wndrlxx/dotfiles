PLUGIN_DIR="$CONFIG_DIR/plugins"

##### Bar Appearance #####
# Configuring the general appearance of the bar.
# These are only some of the options available. For all options see:
# https://felixkratz.github.io/SketchyBar/config/bar
# If you are looking for other colors, see the color picker:
# https://felixkratz.github.io/SketchyBar/config/tricks#color-picker

sketchybar --bar position=top height=28 blur_radius=30 color=0x00000000

##### Changing Defaults #####
# We now change some default values, which are applied to all further items.
# For a full list of all available item properties see:
# https://felixkratz.github.io/SketchyBar/config/items

default=(
  padding_left=0
  padding_right=0
  icon.font="Hack Nerd Font:12.0"
  icon.color=0xffffffff
  label.font="Hack Nerd Font:12.0"
  label.color=0xffffffff
  icon.padding_left=0
  icon.padding_right=0
  label.padding_left=7
  label.padding_right=8
)
sketchybar --default "${default[@]}"

sketchybar --add event aerospace_workspace_change

# Active workspace indicator
sketchybar --add item aerospace_workspace left \
        --subscribe aerospace_workspace aerospace_workspace_change \
        --set aerospace_workspace \
        background.color=0x20ffffff \
        background.corner_radius=10 \
        background.height=20 \
        background.drawing=on \
        icon.drawing=off \
        label.padding_left=14 \
        label.padding_right=14 \
        script="$PLUGIN_DIR/aerospace.sh"

# Currently focused application
sketchybar --add item front_app left \
           --set front_app icon.drawing=off script="$PLUGIN_DIR/front_app.sh" \
           --subscribe front_app front_app_switched

# Date and time with MacBook notch
sketchybar --add item date.notch q \
           --set date.notch drawing=off update_freq=600 script="$PLUGIN_DIR/date.sh"

sketchybar --add item clock.notch e \
           --set clock.notch drawing=off update_freq=6 script="$PLUGIN_DIR/clock.sh"

# Date and time, no notch
sketchybar --add item date center \
           --set date drawing=off update_freq=600 script="$PLUGIN_DIR/date.sh"

sketchybar --add item clock center \
           --set clock drawing=off update_freq=6 script="$PLUGIN_DIR/clock.sh"

# Refresh display associations after monitor changes, including lid open/close.
sketchybar --add item clock_layout left \
           --set clock_layout drawing=off updates=on update_freq=10 \
                 script="/bin/bash \"$PLUGIN_DIR/clock_layout.sh\"" \
           --subscribe clock_layout display_change system_woke

# Conditionally show CPU usage
sketchybar --add item cpu right \
           --set cpu update_freq=6 script="$CONFIG_DIR/plugins/cpu.sh"

##### Force all scripts to run the first time (never do this in a script) #####
sketchybar --update

