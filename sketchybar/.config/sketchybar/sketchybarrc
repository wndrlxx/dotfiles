PLUGIN_DIR="$CONFIG_DIR/plugins"

##### Bar Appearance #####
# Configuring the general appearance of the bar.
# These are only some of the options available. For all options see:
# https://felixkratz.github.io/SketchyBar/config/bar
# If you are looking for other colors, see the color picker:
# https://felixkratz.github.io/SketchyBar/config/tricks#color-picker

sketchybar --bar position=top height=28 blur_radius=30 color=0x00000000 padding_right=16

##### Changing Defaults #####
# We now change some default values, which are applied to all further items.
# For a full list of all available item properties see:
# https://felixkratz.github.io/SketchyBar/config/items

default=(
  padding_left=0
  padding_right=0
  icon.font="Hack Nerd Font:12.0"
  icon.color=0xffffffff
  label.font="Hack Nerd Font:12.0"
  label.color=0xffffffff
  icon.padding_left=0
  icon.padding_right=0
  label.padding_left=7
  label.padding_right=8
)
sketchybar --default "${default[@]}"

sketchybar --add event aerospace_workspace_change

# Active workspace indicator
sketchybar --add item aerospace_workspace left \
        --subscribe aerospace_workspace aerospace_workspace_change \
        --set aerospace_workspace \
        background.color=0x20ffffff \
        background.corner_radius=10 \
        background.height=20 \
        background.drawing=on \
        icon.drawing=off \
        label.padding_left=14 \
        label.padding_right=14 \
        script="$PLUGIN_DIR/aerospace.sh"

# Currently focused application
sketchybar --add item front_app left \
           --set front_app icon.drawing=off script="$PLUGIN_DIR/front_app.sh" \
           --subscribe front_app front_app_switched

# With notch - Left: day and time; Right: weather
sketchybar --add item clock.notch q \
           --set clock.notch drawing=off label.padding_right=0 update_freq=6 script="$PLUGIN_DIR/clock.sh"
sketchybar --add item date.notch q \
           --set date.notch drawing=off label.padding_right=0 update_freq=600 script="$PLUGIN_DIR/date.sh"
sketchybar --add item weather.notch e \
           --set weather.notch drawing=off label="--°C"

# Without notch - Center: time, day, weather
sketchybar --add item clock center \
           --set clock drawing=off label.padding_right=0 update_freq=6 script="$PLUGIN_DIR/clock.sh"
sketchybar --add item date center \
           --set date drawing=off update_freq=600 script="$PLUGIN_DIR/date.sh"
sketchybar --add item weather center \
           --set weather drawing=off label="--°C" updates=on update_freq=900 \
                 script="/bin/bash \"$PLUGIN_DIR/weather.sh\"" \
           --subscribe weather system_woke

# Refresh display associations after monitor changes, including lid open/close.
sketchybar --add item clock_layout left \
           --set clock_layout drawing=off updates=on update_freq=10 \
                 script="/bin/bash \"$PLUGIN_DIR/clock_layout.sh\"" \
           --subscribe clock_layout display_change system_woke

# Codex remaining quota: five-hour bar above, weekly bar below.
sketchybar --add item codex_logo right \
           --set codex_logo width=14 padding_left=0 padding_right=0 \
                 background.drawing=on background.image.drawing=on \
                 background.image="$CONFIG_DIR/assets/codex.png" background.image.scale=0.39 \
                 icon.drawing=off label.drawing=off

sketchybar --add item codex_usage right \
           --set codex_usage width=48 padding_left=0 padding_right=0 \
                 background.drawing=on \
                 icon.drawing=off label.drawing=off update_freq=300 \
                 script="python3 \"$PLUGIN_DIR/codex_usage.py\"" \
                 popup.align=right popup.height=16 popup.background.color=0xee20242b \
                 popup.background.corner_radius=6 popup.background.border_width=1 \
                 popup.background.border_color=0xff454b55 \
           --subscribe codex_usage system_woke mouse.entered mouse.exited mouse.exited.global

# Conditionally show CPU usage to the left of the Codex widget.
sketchybar --add item cpu right \
           --set cpu update_freq=6 script="$CONFIG_DIR/plugins/cpu.sh"

for detail in primary secondary status; do
  sketchybar --add item "codex_usage.$detail" popup.codex_usage \
             --set "codex_usage.$detail" icon.drawing=off label="Loading…" \
                   label.padding_left=12 label.padding_right=12
done

##### Force all scripts to run the first time (never do this in a script) #####
sketchybar --update

