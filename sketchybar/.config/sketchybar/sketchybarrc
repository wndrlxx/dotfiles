PLUGIN_DIR="$CONFIG_DIR/plugins"

##### Bar Appearance #####
# Configuring the general appearance of the bar.
# These are only some of the options available. For all options see:
# https://felixkratz.github.io/SketchyBar/config/bar
# If you are looking for other colors, see the color picker:
# https://felixkratz.github.io/SketchyBar/config/tricks#color-picker

sketchybar --bar position=top topmost=on height=32 blur_radius=30 color=0x00000000 padding_left=12 padding_right=12

##### Changing Defaults #####
# We now change some default values, which are applied to all further items.
# For a full list of all available item properties see:
# https://felixkratz.github.io/SketchyBar/config/items

default=(
  padding_left=0
  padding_right=0
  icon.font="Hack Nerd Font:12.0"
  icon.color=0xffffffff
  label.font="Hack Nerd Font:12.0"
  label.color=0xffffffff
  icon.padding_left=0
  icon.padding_right=0
  label.padding_left=7
  label.padding_right=8
)
sketchybar --default "${default[@]}"

sketchybar --add event aerospace_workspace_change
sketchybar --add event ellie_app_changed

# Active workspace indicator
sketchybar --add item aerospace_workspace left \
        --subscribe aerospace_workspace aerospace_workspace_change \
        --set aerospace_workspace \
        background.color=0x20ffffff \
        background.corner_radius=10 \
        background.height=16 \
        background.drawing=on \
        icon.drawing=off \
        label.padding_left=12 \
        label.padding_right=12 \
        script="$PLUGIN_DIR/aerospace.sh"

# Currently focused application
sketchybar --add item front_app left \
           --set front_app icon.drawing=off script="$PLUGIN_DIR/front_app.sh" \
           --subscribe front_app front_app_switched

# With notch - Left: day and time; Right: active task timer.

sketchybar --add item clock.notch q \
           --set clock.notch drawing=off label.padding_left=7 label.padding_right=0 update_freq=6 script="$PLUGIN_DIR/clock.sh"
sketchybar --add item date.notch q \
           --set date.notch drawing=off label.padding_left=7 label.padding_right=0 update_freq=600 script="$PLUGIN_DIR/date.sh"
sketchybar --add item timer.notch e \
           --set timer.notch drawing=off icon.drawing=off label.drawing=off

# Without notch - Center the group with no extra padding at its outer edges.
sketchybar --add item clock center \
           --set clock drawing=off label.padding_left=0 label.padding_right=4 update_freq=6 script="$PLUGIN_DIR/clock.sh"
sketchybar --add item date center \
           --set date drawing=off label.padding_left=0 label.padding_right=4 update_freq=600 script="$PLUGIN_DIR/date.sh"
sketchybar --add item timer center \
           --set timer drawing=off icon.drawing=off label.drawing=off label.padding_right=0

# Refresh display associations after monitor changes, including lid open/close.
sketchybar --add item clock_layout left \
           --set clock_layout drawing=off updates=on update_freq=10 \
                 script="/bin/bash \"$PLUGIN_DIR/clock_layout.sh\"" \
           --subscribe clock_layout display_change system_woke

# Codex remaining quota: five-hour bar above, weekly bar below.
sketchybar --add item codex_usage right \
           --set codex_usage width=48 padding_left=8 padding_right=2 \
                 background.drawing=on \
                 icon.drawing=off label.drawing=off update_freq=300 \
                 script="python3 \"$PLUGIN_DIR/codex_usage.py\"" \
                 popup.align=right popup.height=16 popup.background.color=0xee20242b \
                 popup.background.corner_radius=6 popup.background.border_width=1 \
                 popup.background.border_color=0xff454b55 \
           --subscribe codex_usage system_woke mouse.entered mouse.exited mouse.exited.global

# Conditionally show CPU usage between network throughput and Codex usage bars.
sketchybar --add item cpu right \
           --set cpu label.padding_left=0 label.padding_right=13 update_freq=6 script="$CONFIG_DIR/plugins/cpu.sh"

# Right-side items are added right-to-left, placing network to the left of CPU.
# Show each network direction only after three seconds above 1 MB/s.
sketchybar --add item network right \
           --set network drawing=off updates=on update_freq=1 \
                 icon.drawing=off label.padding_left=0 label.padding_right=13 \
                 script="python3 -B \"$PLUGIN_DIR/network.py\"" \
           --subscribe network system_woke

# Codex and Pi agent status from Herdr and Rex.
for state in working waiting done error; do
  sketchybar --add item "codex_state.$state" right \
             --set "codex_state.$state" drawing=off padding_right=6 \
                   label.padding_left=4 label.padding_right=0 \
                   script="python3 -B \"$PLUGIN_DIR/codex_status.py\" --popup" \
                   popup.align=right popup.height=22 popup.background.color=0xee20242b \
                   popup.background.corner_radius=6 popup.background.border_width=1 \
                   popup.background.border_color=0xff454b55 \
             --subscribe "codex_state.$state" mouse.entered mouse.exited mouse.exited.global
done

for detail in primary secondary status; do
  sketchybar --add item "codex_usage.$detail" popup.codex_usage \
             --set "codex_usage.$detail" icon.drawing=off label="Loading…" \
                   label.padding_left=12 label.padding_right=12
done

# Use Open Sunsama when its key is configured; override with
# SKETCHYBAR_TIMER_PROVIDER=ellie or sunsama in the SketchyBar environment.
timer_provider="${SKETCHYBAR_TIMER_PROVIDER:-auto}"
if [ "$timer_provider" = auto ]; then
  if [ -n "${OPEN_SUNSAMA_API_KEY:-}" ] || /usr/bin/security find-generic-password -s sketchybar-open-sunsama >/dev/null 2>&1; then
    timer_provider=sunsama
  else
    timer_provider=ellie
  fi
fi
if [ "$timer_provider" = sunsama ]; then
sketchybar --add item sunsama_timer left \
           --set sunsama_timer drawing=off updates=on update_freq=0 \
                 script="python3 -B \"$PLUGIN_DIR/sunsama_timer.py\"" \
           --subscribe sunsama_timer system_woke
python3 -B "$PLUGIN_DIR/sunsama_timer.py" --watch --bar-pid "$PPID" > /dev/null &
else
python3 -B "$PLUGIN_DIR/sunsama_timer.py" --stop
# Render Ellie's active timer; this controller stays hidden.
sketchybar --add item ellie_timer left \
           --set ellie_timer drawing=off updates=on update_freq=0 \
                 script="python3 -B \"$PLUGIN_DIR/ellie_timer.py\"" \
           --subscribe ellie_timer system_woke ellie_app_changed

# Native observer enables ticking only while Ellie is open.
/bin/bash "$PLUGIN_DIR/ellie_watcher.sh" "$PPID" > /dev/null &
fi

# One idle observer, reused on reload; no recurring status script or agent prompts.
python3 -B "$PLUGIN_DIR/codex_status.py" --watch \
  --bar-pid "$PPID" > /dev/null &

##### Force all scripts to run the first time (never do this in a script) #####
sketchybar --update

