[core]
  editor = nvim
  pager = delta
[interactive]
  diffFilter = delta --color-only
[delta]
	navigate = true
	line-numbers = true
	; side-by-side = true
  ; width = 120
[delta "light-mode"]
  light = true
  syntax-theme = rose-pine-dawn
[delta "dark-mode"]
  dark = true
  syntax-theme = tokyonight_night
[merge]
  conflictstyle = diff3
[diff]
  colorMoved = default
