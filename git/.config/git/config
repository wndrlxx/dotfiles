[core]
  editor = nvim
  pager = delta
[interactive]
  diffFilter = delta --color-only
[delta]
	navigate = true
	line-numbers = true
	; side-by-side = true
  ; width = 120
[delta "light-mode"]
  light = true
  syntax-theme = rose-pine-dawn
[delta "dark-mode"]
  dark = true
  syntax-theme = tokyonight_night
[merge]
  conflictstyle = diff3
[diff]
  colorMoved = default

# Pi writes machine-local state into settings.json; keep the dotfiles copy shareable.
# Applied via this repo's .gitattributes. https://github.com/earendil-works/pi/issues/10187
[filter "pi-settings"]
  clean = "jq 'del(.deviceId, .lastChangelogVersion)'"
  # Fail instead of committing unfiltered content if jq is missing.
  required = true
